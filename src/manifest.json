{
  "manifest_version": 2,
  "name": "CRATOS",
  "version": "1.9.1",
  "description": "Captura dados do processo no PJe e automatiza parcialmente a execução de convênios (consultas e registro) para o processo em tela. Quem confirma, assina e envia é sempre você.",
  "browser_specific_settings": {
    "gecko": {
      "id": "cratos@trt18.local",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/Rodrigo-Madalosso-Araujo/CRATOS/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icones/cratos-16.png",
    "32": "icones/cratos-32.png",
    "48": "icones/cratos-48.png",
    "96": "icones/cratos-96.png",
    "128": "icones/cratos-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "https://*.trt18.jus.br/*",
    "https://*.receita.fazenda.gov.br/*",
    "https://renajud.pdpj.jus.br/*",
    "https://indisponibilidade.onr.org.br/*",
    "https://*.censec.org.br/*",
    "https://serasa-judicial.serasaexperian.com.br/*",
    "https://www3.bcb.gov.br/*",
    "https://sniper.pdpj.jus.br/*",
    "https://previdenciario.pdpj.jus.br/*"
  ],
  "background": {
    "scripts": [
      "comum/storage.js",
      "comum/api-pje.js",
      "comum/api-caixa-postal.js",
      "modulos/registro.js",
      "comum/novidades.js",
      "modulos/infojud.js",
      "modulos/sab.js",
      "modulos/renajud.js",
      "modulos/cnib.js",
      "modulos/censec.js",
      "modulos/serasajud.js",
      "modulos/ccs.js",
      "modulos/sniper.js",
      "modulos/prevjud.js",
      "modulos/disponibilidade.js",
      "modulos/juntada.js",
      "comum/unzip.js",
      "modulos/limpeza.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://pje.trt18.jus.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "comum/novidades.js",
        "conteudo/painel.js"
      ],
      "css": [
        "conteudo/painel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pje.trt18.jus.br/sab/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/sab.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.receita.fazenda.gov.br/*"
      ],
      "all_frames": true,
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/infojud-empresas.js",
        "conteudo/ecac-infojud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://renajud.pdpj.jus.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/renajud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://indisponibilidade.onr.org.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/cnib.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.censec.org.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/censec.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://serasa-judicial.serasaexperian.com.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/serasajud.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www3.bcb.gov.br/ccs/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/ccs.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://sniper.pdpj.jus.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/sniper.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://previdenciario.pdpj.jus.br/*"
      ],
      "js": [
        "conteudo/prevjud-cedo.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://previdenciario.pdpj.jus.br/*"
      ],
      "js": [
        "comum/storage.js",
        "comum/relatorio.js",
        "comum/faixa.js",
        "conteudo/prevjud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_icon": {
      "16": "icones/cratos-16.png",
      "32": "icones/cratos-32.png"
    },
    "default_title": "CRATOS"
  },
  "options_ui": {
    "page": "opcoes/opcoes.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "icones/cratos-16.png",
    "icones/cratos-32.png",
    "icones/cratos-48.png",
    "icones/cratos-96.png",
    "icones/cratos-128.png",
    "conteudo/censec-api.js",
    "conteudo/serasajud-api.js",
    "conteudo/renajud-api.js",
    "conteudo/ecac-grampo.js",
    "conteudo/sniper-api.js",
    "conteudo/prevjud-api.js"
  ]
}
